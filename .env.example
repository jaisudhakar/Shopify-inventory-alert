# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# `npm start` reads this file. `npm run dev` does not need it — the Shopify CLI
# injects the Shopify credentials for you. Real environment variables always win
# over this file, so hosted deployments can set them directly instead.

# ---------------------------------------------------------------------------
# Shopify app credentials (Partner Dashboard > Apps > your app > Configuration)
# `shopify app dev` sets these for you locally; they must be set explicitly in
# production.
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example.com
SCOPES=read_products,read_inventory,read_locations

# ---------------------------------------------------------------------------
# Database. SQLite by default; switch prisma/schema.prisma to postgresql and
# put the connection string here for a hosted deployment.
# ---------------------------------------------------------------------------
DATABASE_URL=file:./prisma/dev.sqlite

# ---------------------------------------------------------------------------
# Email delivery. Pick ONE provider. Leave everything blank to run in "console"
# mode, where the digest is printed to the server log instead of sent.
#
# EMAIL_PROVIDER = smtp | resend | sendgrid | console  (auto-detected if unset)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_FROM="Inventory Alerts <alerts@your-domain.com>"

# --- Option A: any SMTP server (Gmail, Mailgun, Postmark, Amazon SES, ...) ---
SMTP_HOST=
SMTP_PORT=587
# Leave blank to infer from the port (465 = implicit TLS, otherwise STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# --- Option B: Resend ---
RESEND_API_KEY=

# --- Option C: SendGrid ---
SENDGRID_API_KEY=

# ---------------------------------------------------------------------------
# Scheduling
#
# The app ships with an in-process scheduler that ticks every 5 minutes and
# sends each shop's digest at its own local send time.
#
# Set ENABLE_SCHEDULER=false when you run more than one web instance, or when
# your host sleeps idle processes — then drive /api/cron/daily from an external
# scheduler instead and protect it with CRON_SECRET.
# ---------------------------------------------------------------------------
ENABLE_SCHEDULER=true
SCHEDULER_CRON=*/5 * * * *
CRON_SECRET=
